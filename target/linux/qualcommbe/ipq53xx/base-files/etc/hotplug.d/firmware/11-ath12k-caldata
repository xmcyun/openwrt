#!/bin/sh

[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

board=$(board_name)

case "$FIRMWARE" in
"ath12k/QCN9274/hw2.0/cal-pci-0001:01:00.0.bin")
	case "$board" in
	tp-link,tl7dr6560)
		# 5G QCN6224 caldata: stock /lib/read_caldata_to_fs.sh ap-mi01.6* branch
		# reads art offset 157696 (0x26880) len 184320 (0x2d000); PC-side
		# verification: art[0x26880:+0x2d000] is 95.6% byte-identical to the
		# stock runtime caldata_2.bin (residual = driver/FTM runtime re-patch).
		# 2.4G (IPQ5332 AHB, M4b future): art offset 0x1000 len 0x20000
		# (md5 byte-exact vs stock runtime caldata.bin).
		caldata_extract "0:ART" 0x26880 0x2d000
		;;
	esac
	;;
*)
	exit 1
	;;
esac
